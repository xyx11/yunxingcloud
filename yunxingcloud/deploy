#!/bin/bash
set -e
# ============================================
# yunxingcloud 一键部署 (自动检测环境)
# 用法:
#   ./deploy               本地 Docker Compose 部署
#   ./deploy docker        同上
#   ./deploy ecs           远程 ECS 部署 (需先配置 deploy.conf)
#   ./deploy k8s           本地 Kind K8s 部署
# ============================================
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC}  $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $1"; }
err()   { echo -e "${RED}[ERROR]${NC} $1"; }
step()  { echo -e "\n${CYAN}▶ $1${NC}"; }

MODE="${1:-auto}"

# ---- 自动检测 ----
if [ "$MODE" = "auto" ]; then
  if [ -f deploy.conf ] && grep -q "SERVER_HOST=" deploy.conf 2>/dev/null; then
    MODE="ecs"
  elif command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
    MODE="docker"
  else
    MODE="local"
  fi
  info "自动检测模式: $MODE"
fi

# ============================================
# 本地 Docker Compose
# ============================================
docker_deploy() {
  step "检查 Docker 环境..."
  if ! docker info &>/dev/null 2>&1; then
    err "Docker 未运行，请先启动 Docker"
    exit 1
  fi

  step "构建&启动全部服务 (docker-compose)..."
  docker-compose up -d --build

  step "等待服务就绪..."
  for svc in nacos mysql redis core usercenter payment order inventory gateway; do
    for i in $(seq 1 30); do
      if docker-compose ps "$svc" 2>/dev/null | grep -q "Up\|healthy"; then
        info "  $svc ✓"
        break
      fi
      sleep 2
    done
  done

  step "健康检查..."
  for i in $(seq 1 15); do
    if curl -sf http://localhost:8090/actuator/health >/dev/null 2>&1; then
      info "Gateway UP → http://localhost:8090"
      break
    fi
    sleep 2
  done

  echo ""
  info "============================================"
  info "  本地部署完成！"
  info "  API:     http://localhost:8090"
  info "  Nacos:   http://localhost:8848/nacos"
  info "  Admin:   http://localhost:8080 (core)"
  info "============================================"
}

# ============================================
# ECS 远程部署
# ============================================
ecs_deploy() {
  if [ ! -f deploy.conf ]; then
    err "deploy.conf 不存在，请先配置: cp deploy.conf.example deploy.conf"
    exit 1
  fi
  source deploy.conf

  step "1/5 构建后端..."
  ./mvnw package \
    -pl yunxingcloud-core,yunxingcloud-usercenter,yunxingcloud-gateway,yunxingcloud-payment,yunxingcloud-order,yunxingcloud-inventory \
    -DskipTests -q --no-transfer-progress
  info "后端构建完成"

  step "2/5 构建前端..."
  (cd frontend-mall && npm run build --silent 2>/dev/null) || true
  info "前端构建完成"

  step "3/5 打包上传..."
  TIMESTAMP=$(date +%Y%m%d_%H%M%S)
  PKG="yunxingcloud-${TIMESTAMP}.tar.gz"
  tar -czf "/tmp/$PKG" \
    yunxingcloud-core/target/yunxingcloud-core-*.jar \
    yunxingcloud-gateway/target/yunxingcloud-gateway-*.jar \
    yunxingcloud-usercenter/target/yunxingcloud-usercenter-*.jar \
    yunxingcloud-payment/target/yunxingcloud-payment-*.jar \
    yunxingcloud-order/target/yunxingcloud-order-*.jar \
    yunxingcloud-inventory/target/yunxingcloud-inventory-*.jar \
    frontend-mall/dist/ \
    setup-prod.sh nginx-production.conf deploy.conf 2>/dev/null

  scp -P "${SERVER_PORT:-22}" "/tmp/$PKG" "$SERVER_USER@$SERVER_HOST:$DEPLOY_DIR/" 2>&1 || {
    warn "SCP 上传失败，请检查 ECS 连接: ssh $SERVER_USER@$SERVER_HOST"
    exit 1
  }
  info "上传完成: $PKG"

  step "4/5 远程部署..."
  ssh -p "${SERVER_PORT:-22}" "$SERVER_USER@$SERVER_HOST" "
    cd $DEPLOY_DIR
    tar -xzf $PKG
    mkdir -p app logs

    # 复制 JAR
    cp yunxingcloud-core/target/yunxingcloud-core-*.jar app/yunxingcloud-core.jar
    cp yunxingcloud-gateway/target/yunxingcloud-gateway-*.jar app/yunxingcloud-gateway.jar
    cp yunxingcloud-usercenter/target/yunxingcloud-usercenter-*.jar app/yunxingcloud-usercenter.jar
    cp yunxingcloud-payment/target/yunxingcloud-payment-*.jar app/yunxingcloud-payment.jar
    cp yunxingcloud-order/target/yunxingcloud-order-*.jar app/yunxingcloud-order.jar
    cp yunxingcloud-inventory/target/yunxingcloud-inventory-*.jar app/yunxingcloud-inventory.jar

    # 重启服务 (按依赖顺序)
    for svc in yunxingcloud-usercenter yunxingcloud-payment yunxingcloud-order yunxingcloud-inventory yunxingcloud-core yunxingcloud-gateway; do
      systemctl restart \$svc 2>/dev/null && echo \"  \$svc restarted\" || true
      sleep 5
    done
  " 2>&1

  step "5/5 健康检查..."
  sleep 10
  for port in 8081 8083 8084 8085 8080 8090; do
    if ssh -p "${SERVER_PORT:-22}" "$SERVER_USER@$SERVER_HOST" \
      "curl -sf http://localhost:$port/actuator/health" 2>/dev/null; then
      info "  :$port ✓"
    else
      warn "  :$port ✗"
    fi
  done

  echo ""
  info "============================================"
  info "  ECS 部署完成！"
  info "  https://${APP_DOMAIN:-$SERVER_HOST}"
  info "============================================"
}

# ============================================
# 本地 K8s (Kind)
# ============================================
k8s_deploy() {
  step "构建 JAR..."
  ./mvnw package \
    -pl yunxingcloud-core,yunxingcloud-usercenter,yunxingcloud-gateway,yunxingcloud-payment,yunxingcloud-order,yunxingcloud-inventory \
    -DskipTests -q --no-transfer-progress

  step "构建 Docker 镜像..."
  for svc in gateway core usercenter payment order inventory; do
    case $svc in core) PORT=8080;; usercenter) PORT=8081;; gateway) PORT=8090;;
      payment) PORT=8083;; order) PORT=8084;; inventory) PORT=8085;; esac
    JAR="yunxingcloud-${svc}/target/yunxingcloud-${svc}-0.0.1-SNAPSHOT.jar"
    docker build --build-arg JAR_FILE="$JAR" --build-arg PORT=$PORT \
      -t yunxingcloud-${svc}:latest -f Dockerfile.local . 2>&1 | tail -1
  done

  step "加载镜像到 Kind..."
  for svc in gateway core usercenter payment order inventory; do
    docker save yunxingcloud-${svc}:latest -o /tmp/${svc}.tar
    docker exec -i yunxingcloud-control-plane sh -c 'cat > /tmp/img.tar' < /tmp/${svc}.tar
    docker exec yunxingcloud-control-plane ctr -n k8s.io images import /tmp/img.tar 2>&1 | grep "saved"
    rm /tmp/${svc}.tar
  done

  step "部署到 K8s..."
  kubectl apply -k k8s/

  step "等待就绪..."
  kubectl wait --for=condition=ready pod \
    -l 'app in (yunxingcloud-core,yunxingcloud-usercenter,yunxingcloud-gateway,yunxingcloud-payment,yunxingcloud-order,yunxingcloud-inventory)' \
    -n yunxingcloud --timeout=180s 2>/dev/null || true

  kubectl get pods -n yunxingcloud
  info "K8s 部署完成"
}

# ============================================
# Dispatch
# ============================================
case "$MODE" in
  docker) docker_deploy ;;
  ecs)    ecs_deploy ;;
  k8s)    k8s_deploy ;;
  local)
    info "本地开发模式 — 使用 dev profile 启动"
    ./mvnw spring-boot:run -pl yunxingcloud-core -Dspring-boot.run.profiles=dev
    ;;
  *)      err "未知模式: $MODE (支持: docker, ecs, k8s, local)"; exit 1 ;;
esac
